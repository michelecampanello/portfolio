---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { skills } from '../data/cv';
---

<Section id="competenze" index="02" eyebrow="Competenze" title="Lo stack con cui lavoro.">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
    {skills.map((s, i) => (
      <article
        class:list={[
          'card reveal flex flex-col gap-5 p-6 sm:p-7',
          i < 2 ? 'lg:col-span-3' : 'lg:col-span-2',
        ]}
      >
        <div class="flex items-center justify-between">
          <div class="grid size-11 place-items-center rounded-xl bg-accent/10 text-accent">
            <Icon name={s.icon} />
          </div>
          <span class="font-mono text-xs text-muted">{String(s.items.length).padStart(2, '0')}</span>
        </div>
        <h3 class="font-display text-xl font-semibold">{s.area}</h3>
        <ul class="flex flex-wrap gap-2">
          {s.items.map((item) => (
            <li class="rounded-lg border border-line bg-bg px-3 py-1.5 font-mono text-[13px]">{item}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</Section>
