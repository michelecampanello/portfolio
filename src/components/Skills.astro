---
import Section from './Section.astro';
import { skills } from '../data/cv';
---

<Section
  id="stack"
  side="A2"
  label="Stack"
  title="Gli attrezzi del <em class='serif-soft text-signal'>mestiere</em>."
  aside="Divisi per dove girano: nel browser, sul server, in tasca."
>
  <ol class="border-t border-ink">
    {skills.map((s, i) => (
      <li class="reveal group relative grid gap-4 border-b border-rule py-7 transition-colors md:grid-cols-12 md:items-baseline md:py-9">
        <span class="label text-soft md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
        <div class="md:col-span-4">
          <h3 class="font-serif text-4xl font-medium tracking-tight transition-[color,font-style] group-hover:text-signal group-hover:italic sm:text-5xl">{s.area}</h3>
          <p class="mt-1 text-soft">{s.blurb}</p>
        </div>
        <ul class="flex flex-wrap gap-2 md:col-span-7 md:justify-end">
          {s.items.map((item) => (
            <li class="rounded-full border border-rule px-3.5 py-1.5 font-mono text-[13px] transition-colors group-hover:border-ink">{item}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Section>
