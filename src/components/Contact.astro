---
import { profile } from '../data/cv';

const links = [
  profile.phone && { href: `tel:${profile.phone.replace(/\s/g, '')}`, label: profile.phone },
  profile.github && { href: profile.github, label: 'GitHub ↗', external: true },
  profile.linkedin && { href: profile.linkedin, label: 'LinkedIn ↗', external: true },
  profile.cvPdf && { href: profile.cvPdf, label: 'Scarica CV ↓', download: true },
].filter(Boolean) as { href: string; label: string; external?: boolean; download?: boolean }[];
---

<section id="contatti" class="bg-ink text-paper">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-8 sm:py-36">
    <p class="reveal label flex gap-3">
      <span class="text-signal">Fine lato B</span><span class="opacity-60">Contatti</span>
    </p>

    <h2 class="reveal mt-8 font-serif text-[clamp(3.5rem,11vw,10rem)] leading-[0.9] font-medium tracking-[-0.03em]">
      Parliamone<span class="text-signal">.</span>
    </h2>

    <div class="reveal mt-12 grid gap-10 md:grid-cols-12">
      <p class="text-lg text-pretty opacity-75 md:col-span-5">
        Hai un team che cerca uno sviluppatore, un progetto da far partire o una domanda sul mio percorso? Rispondo a ogni email, di solito in giornata.
      </p>

      <div class="md:col-span-7 md:text-right">
        <a
          href={`mailto:${profile.email}`}
          class="ink-link font-serif text-[clamp(1.25rem,3.6vw,2.75rem)] break-all italic hover:text-signal sm:break-normal"
        >
          {profile.email}
        </a>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 md:justify-end">
          <button id="copy-email" type="button" data-email={profile.email} class="label ink-link">
            Copia indirizzo
          </button>
          {links.map((l) => (
            <a href={l.href} class="label ink-link" target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined} download={l.download || undefined}>{l.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('copy-email') as HTMLButtonElement | null;
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email!);
      btn.textContent = 'Copiato ✓';
    } catch {
      btn.textContent = btn.dataset.email!;
    }
    setTimeout(() => (btn.textContent = 'Copia indirizzo'), 2000);
  });
</script>
