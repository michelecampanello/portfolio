---
import Section from './Section.astro';
import { projects } from '../data/cv';
---

{projects.length > 0 && (
  <Section
    id="progetti"
    side="B1"
    label="Progetti"
    title="Cose che ho <em class='serif-soft text-signal'>costruito</em>."
  >
    <div class="grid gap-px overflow-hidden border border-rule bg-rule md:grid-cols-2">
      {projects.map((p, i) => (
        <article class="reveal flex flex-col gap-4 bg-paper p-7 sm:p-10">
          <p class="label flex justify-between text-soft">
            <span class="text-signal">{String(i + 1).padStart(2, '0')}</span>
            {p.year && <span>{p.year}</span>}
          </p>
          <h3 class="font-serif text-3xl font-medium">{p.title}</h3>
          <p class="text-soft text-pretty">{p.description}</p>
          <p class="font-mono text-xs">{p.stack.join(' / ')}</p>
          <div class="mt-auto flex gap-6 pt-4">
            {p.url && <a href={p.url} target="_blank" rel="noopener" class="label ink-link">Guarda online ↗</a>}
            {p.repo && <a href={p.repo} target="_blank" rel="noopener" class="label ink-link">Codice ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </Section>
)}
