---
import { profile, skills } from '../data/cv';

const stack = skills.flatMap((s) => s.items).filter((i) => !i.includes('Office'));
const ring = `${profile.role} · ${profile.city} · Est. 2022 · `;
---

<section id="top" class="relative overflow-hidden">
  <div class="mx-auto flex min-h-svh max-w-7xl flex-col px-4 pt-24 pb-10 sm:px-8 sm:pt-28">


    <div class="relative flex flex-1 flex-col justify-center py-12">
      <h1 class="reveal font-serif leading-[0.86] font-medium tracking-[-0.035em]">
        <span class="block text-[clamp(4rem,15vw,13.5rem)]">{profile.firstName}</span>
        <span class="serif-soft block pl-[8vw] text-[clamp(4rem,15vw,13.5rem)] italic">
          {profile.lastName}<span class="text-signal not-italic">.</span>
        </span>
      </h1>

      <!-- Etichetta di vinile che gira -->
      <div class="vinyl pointer-events-none absolute top-6 right-0 hidden size-44 md:block lg:size-56" aria-hidden="true">
        <svg viewBox="0 0 200 200" class="size-full">
          <defs>
            <path id="ring" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
          </defs>
          <circle cx="100" cy="100" r="98" fill="var(--ink)" />
          <circle cx="100" cy="100" r="62" fill="none" stroke="var(--soft)" stroke-opacity=".35" />
          <circle cx="100" cy="100" r="52" fill="none" stroke="var(--soft)" stroke-opacity=".25" />
          <circle cx="100" cy="100" r="34" fill="var(--signal)" />
          <circle cx="100" cy="100" r="4" fill="var(--paper)" />
          <text font-family="JetBrains Mono Variable, monospace" font-size="11" letter-spacing="2.4" fill="var(--paper)">
            <textPath href="#ring">{ring.toUpperCase()}</textPath>
          </text>
        </svg>
      </div>
    </div>

    <div class="reveal grid gap-8 border-t border-rule pt-6 md:grid-cols-12">
      <p class="font-serif text-2xl leading-snug text-pretty sm:text-3xl md:col-span-7">
        <span class="text-signal italic">{profile.role}</span> a {profile.city}. {profile.intro}
      </p>
      <div class="flex flex-wrap items-end gap-3 md:col-span-5 md:justify-end">
        <a href="#contatti" class="group inline-flex items-center gap-3 rounded-full bg-ink py-3 pr-3 pl-6 text-paper transition-colors hover:bg-signal">
          Scrivimi
          <span class="grid size-8 place-items-center rounded-full bg-paper text-ink transition-transform group-hover:-rotate-45">→</span>
        </a>
        <a href="#chi-sono" class="label ink-link py-1">Leggi la storia ↓</a>
      </div>
    </div>
  </div>

  <!-- Nastro con lo stack -->
  <div class="-rotate-1 border-y border-ink bg-signal py-3 text-[#161412]" aria-label="Tecnologie che uso">
    <div class="marquee flex w-max">
      {[0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy ? 'true' : undefined}>
          {stack.map((t) => (
            <li class="flex items-center font-serif text-3xl italic sm:text-4xl">
              <span class="px-6">{t}</span><span class="not-italic">✳</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .vinyl svg { animation: spin 18s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .marquee { animation: marquee 45s linear infinite; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .vinyl svg, .marquee { animation: none; }
    .marquee { width: auto; flex-wrap: wrap; justify-content: center; }
    .marquee > ul { flex-wrap: wrap; justify-content: center; }
    .marquee > [aria-hidden] { display: none; }
  }
</style>
