---
interface Props {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
}
const { id, index, eyebrow, title } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
  <div class="reveal mb-12 flex flex-col gap-3">
    <p class="font-mono text-sm text-accent">
      <span class="text-muted">{index} /</span> {eyebrow}
    </p>
    <h2 class="font-display text-3xl font-semibold tracking-tight text-balance sm:text-5xl">{title}</h2>
  </div>
  <slot />
</section>
