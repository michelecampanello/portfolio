---
import Section from './Section.astro';
import { education, languages, projects } from '../data/cv';

const side = projects.length ? 'B2' : 'B1';
---

<Section
  id="tracklist"
  side={side}
  label="Formazione"
  title="La tracklist, in ordine di <em class='serif-soft text-signal'>uscita</em>."
  aside="Dal più recente al primo. Il lato B è ancora in registrazione."
>
  <ol class="border-t border-ink">
    {education.map((e, i) => (
      <li class="reveal grid grid-cols-[2.5rem_1fr] gap-x-4 gap-y-1 border-b border-rule py-6 sm:grid-cols-[3.5rem_1fr_auto] sm:items-baseline">
        <span class="font-serif text-2xl text-signal italic">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3 class="font-serif text-2xl font-medium sm:text-3xl">{e.title}</h3>
          <p class="mt-1 text-soft">{e.note} <span class="whitespace-nowrap">— {e.org}</span></p>
        </div>
        <span class="label col-start-2 text-soft sm:col-start-3 sm:text-right">{e.year}</span>
      </li>
    ))}
  </ol>

  <div class="mt-20 grid gap-px overflow-hidden border border-rule bg-rule sm:grid-cols-2">
    {languages.map((l) => (
      <div class="reveal bg-paper-2 p-7 sm:p-10">
        <p class="label text-soft">Lingua</p>
        <p class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <span class="font-serif text-3xl font-medium sm:text-4xl">{l.name}</span>
          <span class="font-serif text-3xl text-signal italic sm:text-4xl">{l.level}</span>
        </p>
        <p class="mt-4 text-soft">{l.note}</p>
      </div>
    ))}
  </div>
</Section>
