---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { education, languages, projects } from '../data/cv';

const idx = projects.length ? '04' : '03';
---

<Section id="formazione" index={idx} eyebrow="Formazione & lingue" title="Un percorso in continua crescita.">
  <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
    <ol class="relative border-l border-line pl-8">
      {education.map((e) => (
        <li class="reveal relative pb-10 last:pb-0">
          <span class="absolute top-1 -left-[41px] grid size-[18px] place-items-center rounded-full border border-line bg-bg">
            <span class="size-2 rounded-full bg-accent"></span>
          </span>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="font-mono text-sm text-accent">{e.period}</span>
            <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{e.kind}</span>
          </div>
          <h3 class="mt-2 font-display text-xl font-semibold">{e.title}</h3>
          <p class="text-muted">{e.subtitle}</p>
          <p class="mt-1 inline-flex items-center gap-1.5 text-sm text-muted">
            <Icon name={e.kind === 'Certificazione' ? 'award' : 'cap'} class="size-4" />
            {e.org}
          </p>
        </li>
      ))}
    </ol>

    <div class="space-y-4">
      <h3 class="reveal flex items-center gap-2 font-display text-xl font-semibold">
        <Icon name="globe" class="size-5 text-accent" /> Lingue
      </h3>
      {languages.map((l) => (
        <div class="card reveal p-6">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-display text-lg font-semibold">{l.name}</span>
            <span class="font-mono text-sm text-accent">{l.level}</span>
          </div>
          <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-line">
            <div class="h-full rounded-full" style={`width:${l.score}%;background:linear-gradient(90deg,var(--accent),var(--accent-2))`}></div>
          </div>
          {l.note && <p class="mt-3 text-sm text-muted">{l.note}</p>}
        </div>
      ))}
    </div>
  </div>
</Section>
